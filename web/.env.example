# Person:Passwort, durch Komma getrennt. Die Person landet als „[von Opa]“ im
# oskalizer. Passwörter ohne Komma. Eintrag löschen = Zugang weg.
FAMILY_PASSWORDS=
# Langer Zufallswert, signiert das Login-Cookie: openssl rand -base64 32
SESSION_SECRET=
# Gmail-Konto, das die Aufnahmen verschickt
GMAIL_USER=
# Google-Konto → Sicherheit → 2-Schritt-Verifizierung → App-Passwörter
GMAIL_APP_PASSWORD=
# Wohin die Aufnahmen gehen
MAIL_TO=
